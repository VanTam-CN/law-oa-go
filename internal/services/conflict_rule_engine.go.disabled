// GetRuleStatistics 获取规则统计信息
func (e *ConflictRuleEngine) GetRuleStatistics(ctx *gin.Context) (map[string]interface{}, error) {
	rules, err := e.getActiveRules(ctx)
	if err != nil {
		return nil, err
	}

	stats := map[string]interface{}{
		"total_rules":    len(rules),
		"active_rules":   0,
		"rule_types":     make(map[string]int),
		"risk_levels":    make(map[string]int),
		"last_updated":   time.Now().Format("2006-01-02 15:04:05"),
	}

	for _, rule := range rules {
		if rule.Active {
			stats["active_rules"] = stats["active_rules"].(int) + 1
		}

		ruleTypes := stats["rule_types"].(map[string]int)
		ruleTypes[rule.Type]++

		riskLevels := stats["risk_levels"].(map[string]int)
		if rule.Priority >= 80 {
			riskLevels["HIGH"]++
		} else if rule.Priority >= 50 {
			riskLevels["MEDIUM"]++
		} else {
			riskLevels["LOW"]++
		}
	}

	return stats, nil
}