		}
	}

	return conflicts
}

// isNameSimilar 判断两个名称是否相似
func (s *EnhancedConflictServiceV2) isNameSimilar(name1, name2 string, threshold float64) bool {
	if name1 == "" || name2 == "" {
		return false
	}

	distance := s.levenshteinDistance(strings.ToLower(name1), strings.ToLower(name2))
	maxLen := maxV2(len(name1), len(name2))
	if maxLen == 0 {
		return true
	}

	similarity := 1.0 - float64(distance)/float64(maxLen)
	return similarity >= threshold
}

// levenshteinDistance 计算编辑距离
func (s *EnhancedConflictServiceV2) levenshteinDistance(s1, s2 string) int {
	if len(s1) < len(s2) {
		s1, s2 = s2, s1
	}
	if len(s2) == 0 {
		return len(s1)
	}

	previousRow := make([]int, len(s2)+1)
	for i := 0; i <= len(s2); i++ {
		previousRow[i] = i
	}

	for i, c1 := range s1 {
		currentRow := previousRow[0] + 1
		previousRow[0] = i + 1

		for j, c2 := range s2 {
			insertCost := previousRow[j] + 1
			deleteCost := currentRow[j] + 1
			replaceCost := previousRow[j]

			if c1 != c2 {
				replaceCost++
			}

			currentRow[j] = minV2(minV2(insertCost, deleteCost), replaceCost)
			previousRow[j] = currentRow[j]
		}
	}

	return previousRow[len(s2)]
}

func minV2(a, b int) int {
	if a < b {
		return a
	}
	return b
}

func maxV2(a, b int) int {
	if a > b {
		return a
	}
	return b
}

// calculateOverallRiskScore 计算总体风险分数
func (s *EnhancedConflictServiceV2) calculateOverallRiskScore(result *repositories.ConflictAnalysisResult) int {
	if len(result.ConflictCases) == 0 {
		return 0
	}

	totalScore := 0
	weightSum := 0

	// 根据冲突类型加权计算风险分数
	for _, conflict := range result.ConflictCases {
		var weight float64
		switch conflict.ConflictType {
		case "direct_client_conflict":
			weight = 1.0 // 最高权重
		case "industry_competition":
			weight = 0.8
		case "name_similarity":
			weight = 0.6
		case "related_conflicts":
			weight = 0.4
		default:
			weight = 0.5
		}

		totalScore += int(float64(conflict.RiskScore) * weight)
		weightSum += weight
	}

	if weightSum > 0 {
		return totalScore / int(weightSum)
	}
	return totalScore
}

// determineRiskLevel 确定风险等级
func (s *EnhancedConflictServiceV2) determineRiskLevel(score int) string {
	switch {
	case score >= 80:
		return "HIGH"
	case score >= 60:
		return "MEDIUM"
	case score >= 40:
		return "LOW"
	default:
		return "NONE"
	}
}

// generateRecommendations 生成建议
func (s *EnhancedConflictServiceV2) generateRecommendations(result *repositories.ConflictAnalysisResult) []string {
	recommendations := make([]string, 0)

	if result.HasConflicts {
		recommendations = append(recommendations, "⚠️ 检测到潜在利益冲突，建议进行详细审查")
		recommendations = append(recommendations, "📋 建议咨询律师或合规部门确认")

		if result.ConflictLevel == "HIGH" {
			recommendations = append(recommendations, "🚨 高风险冲突，强烈建议避免接受此案件")
		}

		// 根据冲突类型添加具体建议
		conflictTypes := make(map[string]bool)
		for _, conflict := range result.ConflictCases {
			conflictTypes[conflict.ConflictType] = true
		}

		if conflictTypes["industry_competition"] {
			recommendations = append(recommendations, "🏭 检测到行业竞争关系，建议评估市场影响")
		}

		if conflictTypes["direct_client_conflict"] {
			recommendations = append(recommendations, "👥 检测到直接客户冲突，必须避免代理")
		}
	} else {
		recommendations = append(recommendations, "✅ 未发现明显利益冲突")
		recommendations = append(recommendations, "📝 建议在案件进行过程中持续监控")
	}

	recommendations = append(recommendations, "🔍 如发现新的相关信息，请及时进行补充检查")

	return recommendations
}