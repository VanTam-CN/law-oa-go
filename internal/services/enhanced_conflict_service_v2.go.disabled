// EnhancedConflictServiceV2 重构的增强冲突检测服务
type EnhancedConflictServiceV2 struct {
	repo                     repositories.EnhancedConflictRepository
	industryCompetitionSvc   *IndustryCompetitionServiceV2
	riskAssessmentService    *RiskAssessmentServiceV2
	conflictRuleEngine       *ConflictRuleEngineV2
	logger                  *log.Logger
}

// NewEnhancedConflictServiceV2 创建新的增强冲突检测服务
func NewEnhancedConflictServiceV2(repo repositories.EnhancedConflictRepository) *EnhancedConflictServiceV2 {
	return &EnhancedConflictServiceV2{
		repo:                   repo,
		industryCompetitionSvc: NewIndustryCompetitionServiceV2(repo),
		riskAssessmentService:  NewRiskAssessmentServiceV2(repo),
		conflictRuleEngine:     NewConflictRuleEngineV2(repo),
		logger:                 log.Default(),
	}
}

// CheckConflictsV2 执行冲突检测 (重构版本)
func (s *EnhancedConflictServiceV2) CheckConflictsV2(ctx *gin.Context, request *repositories.AdvancedConflictCheckRequest) (*repositories.ConflictAnalysisResult, error) {
	startTime := time.Now()

	// 1. 请求验证
	validation := repositories.ValidateConflictRequest(request)
	if !validation.IsValid {
		return nil, fmt.Errorf("请求验证失败: %v", validation.Errors)
	}

	// 2. 生成请求ID
	requestID := fmt.Sprintf("REQ_%d_%d", startTime.Unix(), request.LawyerID)

	s.logger.Printf("🔍 开始增强冲突检测 - RequestID: %s, 律师: %d, 客户: %s", requestID, request.LawyerID, request.ClientName)

	// 3. 初始化结果结构
	result := &repositories.ConflictAnalysisResult{
		RequestID:       requestID,
		HasConflicts:    false,
		ConflictLevel:   "NONE",
		RiskScore:       0,
		ConflictCases:   make([]*repositories.ConflictCaseDetail, 0),
		Recommendations: make([]string, 0),
		AnalysisSummary: &repositories.AnalysisSummary{
			TotalCasesChecked:   0,
			DirectConflicts:     0,
			IndustryConflicts:   0,
			NameSimilarityCases: 0,
			RelatedConflicts:    0,
			SearchScope:         request.SearchDepth,
			SearchTimeRange:     fmt.Sprintf("%d年", request.SearchYears),
		},
		DetectionTime: startTime,
	}

	// 4. 检测各种类型的冲突
	err := s.detectConflictTypes(ctx, request, result)
	if err != nil {
		s.logger.Printf("❌ 冲突检测失败: %v", err)
		return nil, err
	}

	// 5. 计算总体风险等级
	result.RiskScore = s.calculateOverallRiskScore(result)
	result.ConflictLevel = s.determineRiskLevel(result.RiskScore)

	// 6. 生成建议
	result.Recommendations = s.generateRecommendations(result)

	// 7. 设置持续时间
	result.Duration = time.Since(startTime).Milliseconds()
	result.DetectionTime = time.Now()

	s.logger.Printf("✅ 冲突检测完成 - RequestID: %s, 发现冲突: %v, 风险等级: %s, 用时: %dms",
		requestID, result.HasConflicts, result.ConflictLevel, result.Duration)

	return result, nil
}

// detectConflictTypes 检测各种类型的冲突
func (s *EnhancedConflictServiceV2) detectConflictTypes(ctx context.Context, request *repositories.AdvancedConflictCheckRequest, result *repositories.ConflictAnalysisResult) error {
	// 1. 检测直接客户冲突
	directConflicts, err := s.repo.GetPotentialConflicts(ctx, request.LawyerID, request.ClientName, request.OpposingParty)
	if err != nil {
		s.logger.Printf("检测直接冲突失败: %v", err)
	} else {
		for _, conflictCase := range directConflicts {
			caseDetail := &repositories.ConflictCaseDetail{
				Case:           conflictCase,
				ConflictType:   "direct_client_conflict",
				RiskScore:      90, // 直接冲突风险高
				ConflictReason:  "检测到直接客户冲突",
				ImpactLevel:    "HIGH",
			}
			result.ConflictCases = append(result.ConflictCases, caseDetail)
			result.AnalysisSummary.DirectConflicts++
		}
	}

	// 2. 检测行业竞争冲突
	if request.ClientIndustry != "" {
		industryConflicts, err := s.repo.GetPotentialConflictsAdvanced(ctx, request)
		if err != nil {
			s.logger.Printf("检测行业冲突失败: %v", err)
		} else {
			for _, conflictCase := range industryConflicts {
				caseDetail := &repositories.ConflictCaseDetail{
					Case:           conflictCase,
					ConflictType:   "industry_competition",
					RiskScore:      75, // 行业冲突风险中等偏高
					ConflictReason:  "检测到行业竞争关系",
					ImpactLevel:    "MEDIUM",
				}
				result.ConflictCases = append(result.ConflictCases, caseDetail)
				result.AnalysisSummary.IndustryConflicts++
			}
		}
	}

	// 3. 检测名称相似性冲突
	nameSimilarityConflicts := s.detectNameSimilarityConflicts(ctx, request, result)
	for _, caseDetail := range nameSimilarityConflicts {
		result.ConflictCases = append(result.ConflictCases, caseDetail)
		result.AnalysisSummary.NameSimilarityCases++
	}

	// 4. 检测相关方冲突
	if request.IncludeRelated {
		relatedConflicts := s.detectRelatedConflicts(ctx, request, result)
		for _, caseDetail := range relatedConflicts {
			result.ConflictCases = append(result.ConflictCases, caseDetail)
			result.AnalysisSummary.RelatedConflicts++
		}
	}

	// 5. 更新冲突状态
	result.HasConflicts = len(result.ConflictCases) > 0
	result.AnalysisSummary.TotalCasesChecked = result.AnalysisSummary.DirectConflicts +
		result.AnalysisSummary.IndustryConflicts +
		result.AnalysisSummary.NameSimilarityCases +
		result.AnalysisSummary.RelatedConflicts

	return nil
}

// detectNameSimilarityConflicts 检测名称相似性冲突
func (s *EnhancedConflictServiceV2) detectNameSimilarityConflicts(ctx context.Context, request *repositories.AdvancedConflictCheckRequest, result *repositories.ConflictAnalysisResult) []*repositories.ConflictCaseDetail {
	// 实现基于编辑距离的名称相似性检测
	var conflicts []*repositories.ConflictCaseDetail

	// 模拟实现 - 实际应该查询数据库
	if s.isNameSimilar(request.ClientName, request.OpposingParty, 0.8) {
		// 创建虚拟案件用于演示
		virtualCase := &models.Case{
			ID:            9999,
			Title:        "相似客户案件",
			Description:   "检测到客户名称高度相似",
			ClientID:     1,
			CaseType:     request.CaseType,
			Status:       "in_progress",
			OpposingParty: request.OpposingParty,
			ClientName:   request.ClientName,
			CreatedAt:    time.Now(),
			UpdatedAt:    time.Now(),
		}

		conflicts = append(conflicts, &repositories.ConflictCaseDetail{
			Case:           virtualCase,
			ConflictType:   "name_similarity",
			RiskScore:      60,
			ConflictReason:  "检测到客户名称高度相似",
			ImpactLevel:    "MEDIUM",
		})
	}

	return conflicts
}

