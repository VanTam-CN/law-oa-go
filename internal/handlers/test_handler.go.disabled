	h.logger.Info("Test case execution started", "execution_id", execution.ID, "case_id", caseID)
	c.JSON(200, common.NewSuccessResponse(response))
}

// GetExecution godoc
// @Summary 获取测试执行详情
// @Description 根据ID获取测试执行详情
// @Tags 测试执行
// @Accept json
// @Produce json
// @Param id path string true "执行ID"
// @Success 200 {object} common.APIResponse{data=TestExecutionResponse} "获取成功"
// @Failure 400 {object} common.APIResponse "请求参数错误"
// @Failure 404 {object} common.APIResponse "执行记录不存在"
// @Failure 500 {object} common.APIResponse "服务器错误"
// @Router /api/v1/test/executions/{id} [get]
// @Security BearerAuth
func (h *TestHandler) GetExecution(c *gin.Context) {
	executionID := c.Param("id")
	if executionID == "" {
		c.JSON(400, common.NewErrorResponse("INVALID_REQUEST", "执行ID不能为空"))
		return
	}

	execution, err := h.testService.GetExecution(c.Request.Context(), executionID)
	if err != nil {
		if err.Error() == "test execution not found" {
			c.JSON(404, common.NewErrorResponse("NOT_FOUND", "执行记录不存在"))
			return
		}
		h.logger.Error("Failed to get test execution", "error", err, "execution_id", executionID)
		c.JSON(500, common.NewErrorResponse("INTERNAL_ERROR", "获取执行记录失败", err.Error()))
		return
	}

	// 转换为响应格式
	response := TestExecutionResponse{
		ID:           execution.ID,
		SuiteID:      execution.SuiteID,
		CaseID:       execution.CaseID,
		Status:       string(execution.Status),
		StartTime:    execution.StartTime,
		EndTime:      execution.EndTime,
		Duration:     int(execution.Duration.Seconds()),
		TotalTests:   execution.TotalTests,
		PassedTests:  execution.PassedTests,
		FailedTests:  execution.FailedTests,
		SkippedTests: execution.SkippedTests,
		Progress:     execution.Progress,
		Config:       execution.Config,
		CreatedAt:    execution.CreatedAt,
		UpdatedAt:    execution.UpdatedAt,
	}

	c.JSON(200, common.NewSuccessResponse(response))
}

// ListExecutions godoc
// @Summary 获取测试执行列表
// @Description 分页获取测试执行列表，支持过滤
// @Tags 测试执行
// @Accept json
// @Produce json
// @Param page query int false "页码" default(1)
// @Param page_size query int false "每页数量" default(20)
// @Param suite_id query string false "测试套件ID过滤"
// @Param case_id query string false "测试用例ID过滤"
// @Param status query string false "状态过滤"
// @Param started_after query string false "开始时间过滤（RFC3339格式）"
// @Param started_before query string false "开始时间过滤（RFC3339格式）"
// @Success 200 {object} common.APIResponse{data=[]TestExecutionResponse,pagination=common.PaginationInfo} "获取成功"
// @Failure 500 {object} common.APIResponse "服务器错误"
// @Router /api/v1/test/executions [get]
// @Security BearerAuth
func (h *TestHandler) ListExecutions(c *gin.Context) {
	// 解析查询参数
	page, _ := strconv.Atoi(c.DefaultQuery("page", "1"))
	pageSize, _ := strconv.Atoi(c.DefaultQuery("page_size", "20"))

	if page < 1 {
		page = 1
	}
	if pageSize < 1 || pageSize > 100 {
		pageSize = 20
	}

	offset := (page - 1) * pageSize

	// 解析时间过滤参数
	var startedAfter, startedBefore *time.Time
	if startedAfterStr := c.Query("started_after"); startedAfterStr != "" {
		if t, err := time.Parse(time.RFC3339, startedAfterStr); err == nil {
			startedAfter = &t
		}
	}
	if startedBeforeStr := c.Query("started_before"); startedBeforeStr != nil {
		if t, err := time.Parse(time.RFC3339, *startedBeforeStr); err == nil {
			startedBefore = &t
		}
	}

	filter := &testing.TestExecutionFilter{
		SuiteID:      c.Query("suite_id"),
		CaseID:       c.Query("case_id"),
		Status:       testing.TestStatus(c.Query("status")),
		StartedAfter: startedAfter,
		StartedBefore: startedBefore,
		Limit:        pageSize,
		Offset:       offset,
	}

	executions, err := h.testService.ListExecutions(c.Request.Context(), filter)
	if err != nil {
		h.logger.Error("Failed to list test executions", "error", err)
		c.JSON(500, common.NewErrorResponse("INTERNAL_ERROR", "获取执行列表失败", err.Error()))
		return
	}

	// 转换为响应格式
	response := make([]TestExecutionResponse, len(executions))
	for i, execution := range executions {
		response[i] = TestExecutionResponse{
			ID:           execution.ID,
			SuiteID:      execution.SuiteID,
			CaseID:       execution.CaseID,
			Status:       string(execution.Status),
			StartTime:    execution.StartTime,
			EndTime:      execution.EndTime,
			Duration:     int(execution.Duration.Seconds()),
			TotalTests:   execution.TotalTests,
			PassedTests:  execution.PassedTests,
			FailedTests:  execution.FailedTests,
			SkippedTests: execution.SkippedTests,
			Progress:     execution.Progress,
			Config:       execution.Config,
			CreatedAt:    execution.CreatedAt,
			UpdatedAt:    execution.UpdatedAt,
		}
	}

	// 构建分页信息
	pagination := &common.PaginationInfo{
		Page:       page,
		PageSize:   pageSize,
		Total:      int64(len(response)), // 这里需要从服务获取实际总数
		TotalPages: (len(response) + pageSize - 1) / pageSize,
		HasNext:    len(response) == pageSize,
		HasPrev:    page > 1,
	}

	c.JSON(200, common.NewPaginatedResponse(response, pagination))
}

// CancelExecution godoc
// @Summary 取消测试执行
// @Description 取消正在运行的测试执行
// @Tags 测试执行
// @Accept json
// @Produce json
// @Param id path string true "执行ID"
// @Success 200 {object} common.APIResponse "取消成功"
// @Failure 400 {object} common.APIResponse "请求参数错误"
// @Failure 404 {object} common.APIResponse "执行记录不存在"
// @Failure 409 {object} common.APIResponse "执行已完成，无法取消"
// @Failure 500 {object} common.APIResponse "服务器错误"
// @Router /api/v1/test/executions/{id}/cancel [post]
// @Security BearerAuth
func (h *TestHandler) CancelExecution(c *gin.Context) {
	executionID := c.Param("id")
	if executionID == "" {
		c.JSON(400, common.NewErrorResponse("INVALID_REQUEST", "执行ID不能为空"))
		return
	}

	if err := h.testService.CancelExecution(c.Request.Context(), executionID); err != nil {
		if err.Error() == "test execution not found" {
			c.JSON(404, common.NewErrorResponse("NOT_FOUND", "执行记录不存在"))
			return
		}
		if err.Error() == "test execution already completed" {
			c.JSON(409, common.NewErrorResponse("CONFLICT", "执行已完成，无法取消"))
			return
		}
		h.logger.Error("Failed to cancel test execution", "error", err, "execution_id", executionID)
		c.JSON(500, common.NewErrorResponse("INTERNAL_ERROR", "取消执行失败", err.Error()))
		return
	}

	h.logger.Info("Test execution cancelled successfully", "execution_id", executionID)
	c.JSON(200, common.NewSuccessResponse(map[string]string{"message": "执行已取消"}))
}

// GetTestResults godoc
// @Summary 获取测试结果
// @Description 获取指定执行的测试结果列表
// @Tags 测试执行
// @Accept json
// @Produce json
// @Param execution_id path string true "执行ID"
// @Param page query int false "页码" default(1)
// @Param page_size query int false "每页数量" default(20)
// @Success 200 {object} common.APIResponse{data=[]TestResultResponse,pagination=common.PaginationInfo} "获取成功"
// @Failure 400 {object} common.APIResponse "请求参数错误"
// @Failure 404 {object} common.APIResponse "执行记录不存在"
// @Failure 500 {object} common.APIResponse "服务器错误"
// @Router /api/v1/test/executions/{execution_id}/results [get]
// @Security BearerAuth
func (h *TestHandler) GetTestResults(c *gin.Context) {
	executionID := c.Param("execution_id")
	if executionID == "" {
		c.JSON(400, common.NewErrorResponse("INVALID_REQUEST", "执行ID不能为空"))
		return
	}

	// 验证执行是否存在
	_, err := h.testService.GetExecution(c.Request.Context(), executionID)
	if err != nil {
		if err.Error() == "test execution not found" {
			c.JSON(404, common.NewErrorResponse("NOT_FOUND", "执行记录不存在"))
			return
		}
		h.logger.Error("Failed to get test execution", "error", err, "execution_id", executionID)
		c.JSON(500, common.NewErrorResponse("INTERNAL_ERROR", "获取执行记录失败", err.Error()))
		return
	}

	// 解析分页参数
	page, _ := strconv.Atoi(c.DefaultQuery("page", "1"))
	pageSize, _ := strconv.Atoi(c.DefaultQuery("page_size", "20"))

	if page < 1 {
		page = 1
	}
	if pageSize < 1 || pageSize > 100 {
		pageSize = 20
	}

	offset := (page - 1) * pageSize

	filter := &testing.TestResultFilter{
		ExecutionID: executionID,
		Limit:       pageSize,
		Offset:      offset,
	}

	results, err := h.testService.GetTestResults(c.Request.Context(), executionID)
	if err != nil {
		h.logger.Error("Failed to get test results", "error", err, "execution_id", executionID)
		c.JSON(500, common.NewErrorResponse("INTERNAL_ERROR", "获取测试结果失败", err.Error()))
		return
	}

	// 转换为响应格式
	response := make([]TestResultResponse, len(results))
	for i, result := range results {
		var apiError *common.APIError
		if result.Error != nil {
			apiError = &common.APIError{
				Code:    result.Error.Type,
				Message: result.Error.Message,
				Details: result.Error.Details,
			}
		}

		// 转换断言
		assertions := make([]TestAssertionResponse, len(result.Assertions))
		for j, assertion := range result.Assertions {
			assertions[j] = TestAssertionResponse{
				Name:         assertion.Name,
				Type:         assertion.Type,
				Actual:       assertion.Actual,
				Expected:     assertion.Expected,
				Passed:       assertion.Passed,
				ErrorMessage: assertion.ErrorMessage,
			}
		}

		response[i] = TestResultResponse{
			ID:          result.ID,
			TestCaseID:  result.TestCaseID,
			ExecutionID: result.ExecutionID,
			Name:        result.Name,
			Type:        string(result.Type),
			Status:      string(result.Status),
			StartTime:   result.StartTime,
			EndTime:     result.EndTime,
			Duration:    int(result.Duration.Milliseconds()),
			Passed:      result.Passed,
			Error:       apiError,
			Assertions:  assertions,
			Metadata:    result.Metadata,
			Screenshots: result.Screenshots,
			Logs:        result.Logs,
			CreatedAt:   result.CreatedAt,
			UpdatedAt:   result.UpdatedAt,
		}
	}

	// 构建分页信息
	pagination := &common.PaginationInfo{
		Page:       page,
		PageSize:   pageSize,
		Total:      int64(len(response)), // 这里需要从服务获取实际总数
		TotalPages: (len(response) + pageSize - 1) / pageSize,
		HasNext:    len(response) == pageSize,
		HasPrev:    page > 1,
	}

	c.JSON(200, common.NewPaginatedResponse(response, pagination))
}

// GetTestResult godoc
// @Summary 获取测试结果详情
// @Description 根据ID获取测试结果详情
// @Tags 测试执行
// @Accept json
// @Produce json
// @Param id path string true "结果ID"
// @Success 200 {object} common.APIResponse{data=TestResultResponse} "获取成功"
// @Failure 400 {object} common.APIResponse "请求参数错误"
// @Failure 404 {object} common.APIResponse "测试结果不存在"
// @Failure 500 {object} common.APIResponse "服务器错误"
// @Router /api/v1/test/results/{id} [get]
// @Security BearerAuth
func (h *TestHandler) GetTestResult(c *gin.Context) {
	resultID := c.Param("id")
	if resultID == "" {
		c.JSON(400, common.NewErrorResponse("INVALID_REQUEST", "结果ID不能为空"))
		return
	}

	result, err := h.testService.GetTestResult(c.Request.Context(), resultID)
	if err != nil {
		if err.Error() == "test result not found" {
			c.JSON(404, common.NewErrorResponse("NOT_FOUND", "测试结果不存在"))
			return
		}
		h.logger.Error("Failed to get test result", "error", err, "result_id", resultID)
		c.JSON(500, common.NewErrorResponse("INTERNAL_ERROR", "获取测试结果失败", err.Error()))
		return
	}

	// 转换为响应格式
	var apiError *common.APIError
	if result.Error != nil {
		apiError = &common.APIError{
			Code:    result.Error.Type,
			Message: result.Error.Message,
			Details: result.Error.Details,
		}
	}

	// 转换断言
	assertions := make([]TestAssertionResponse, len(result.Assertions))
	for i, assertion := range result.Assertions {
		assertions[i] = TestAssertionResponse{
			Name:         assertion.Name,
			Type:         assertion.Type,
			Actual:       assertion.Actual,
			Expected:     assertion.Expected,
			Passed:       assertion.Passed,
			ErrorMessage: assertion.ErrorMessage,
		}
	}

	response := TestResultResponse{
		ID:          result.ID,
		TestCaseID:  result.TestCaseID,
		ExecutionID: result.ExecutionID,
		Name:        result.Name,
		Type:        string(result.Type),
		Status:      string(result.Status),
		StartTime:   result.StartTime,
		EndTime:     result.EndTime,
		Duration:    int(result.Duration.Milliseconds()),
		Passed:      result.Passed,
		Error:       apiError,
		Assertions:  assertions,
		Metadata:    result.Metadata,
		Screenshots: result.Screenshots,
		Logs:        result.Logs,
		CreatedAt:   result.CreatedAt,
		UpdatedAt:   result.UpdatedAt,
	}

	c.JSON(200, common.NewSuccessResponse(response))
}

// GetSchedulerStatus godoc
// @Summary 获取调度器状态
// @Description 获取测试调度器的当前状态和统计信息
// @Tags 系统监控
// @Accept json
// @Produce json
// @Success 200 {object} common.APIResponse{data=SchedulerStatusResponse} "获取成功"
// @Failure 500 {object} common.APIResponse "服务器错误"
// @Router /api/v1/test/scheduler/status [get]
// @Security BearerAuth
func (h *TestHandler) GetSchedulerStatus(c *gin.Context) {
	status := h.testService.GetSchedulerStatus()

	// 转换运行中测试
	runningTests := make([]RunningTestResponse, len(status.RunningTests))
	for i, test := range status.RunningTests {
		runningTests[i] = RunningTestResponse{
			TestID:      test.TestID,
			ExecutionID: test.ExecutionID,
			Status:      string(test.Status),
			Progress:    test.Progress,
			StartTime:   test.StartTime,
			Duration:    int(test.Duration.Seconds()),
		}
	}

	response := SchedulerStatusResponse{
		Running:            status.Running,
		QueueSize:          status.QueueSize,
		RunningTestsCount:  status.RunningTestsCount,
		CompletedTestsCount: status.CompletedTestsCount,
		MaxConcurrent:      status.MaxConcurrent,
		OldestQueuedTime:   int(status.OldestQueuedTime.Seconds()),
		RunningTests:       runningTests,
	}

	c.JSON(200, common.NewSuccessResponse(response))
}