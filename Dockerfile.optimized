# 基于最新Docker最佳实践的多阶段构建 - 生产环境优化版本
# 构建阶段：使用官方Go镜像，利用层缓存和构建优化
FROM golang:1.23-alpine AS builder

# 设置构建参数
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG BUILD_COMMIT
ARG BUILD_DATE
ARG BUILD_VERSION
ARG VERSION=dev

# 设置环境变量
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GOARCH=${TARGETPLATFORM#linux/}
ENV GOPROXY=https://proxy.golang.org,direct
ENV GOSUMDB=sum.golang.org

# 设置工作目录
WORKDIR /build

# 安装构建依赖（最小化）
RUN apk add --no-cache \
    ca-certificates \
    git \
    tzdata \
    && update-ca-certificates

# 创建非root用户用于构建
RUN addgroup -g 1001 -S builder && \
    adduser -u 1001 -S builder -G builder

# 设置构建用户
USER builder

# 复制依赖文件（利用层缓存）
COPY --chown=builder:builder go.mod go.sum ./

# 下载依赖并验证
RUN go mod download && \
    go mod verify && \
    go mod tidy

# 复制源代码（利用层缓存）
COPY --chown=builder:builder . .

# 构建应用（使用最佳实践优化）
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg \
    VERSION="${VERSION}" \
    BUILD_COMMIT="${BUILD_COMMIT}" \
    BUILD_DATE="${BUILD_DATE}" \
    go build \
    -a \
    -installsuffix cgo \
    -ldflags="-s -w \
    -X main.Version=${VERSION} \
    -X main.GitCommit=${BUILD_COMMIT} \
    -X main.BuildDate=${BUILD_DATE} \
    -extldflags '-static'" \
    -trimpath \
    -o law-oa-go .

# 运行时阶段：最小化distroless镜像以提高安全性
FROM gcr.io/distroless/static-debian12:latest

# 从构建阶段复制CA证书
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# 设置标签（用于元数据和追踪）
LABEL org.opencontainers.image.title="Law OA Go Application"
LABEL org.opencontainers.image.description="现代化律师事务所办公自动化系统后端服务"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${BUILD_COMMIT}"
LABEL org.opencontainers.image.source="https://github.com/your-org/law-oa-go"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.vendor="Law OA Team"

# 从构建阶段复制二进制文件
COPY --from=builder /build/law-oa-go /usr/local/bin/law-oa-go

# 创建非root用户和组
USER 65534:65534

# 设置工作目录
WORKDIR /app

# 创建必要的目录
RUN mkdir -p /app/uploads/contract /app/uploads/evidence /app/uploads/letter /app/uploads/other /app/logs

# 暴露端口
EXPOSE 8080

# 健康检查（使用应用内置健康检查）
HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=10s \
    --retries=3 \
    CMD ["/usr/local/bin/law-oa-go", "healthcheck"]

# 启动应用
ENTRYPOINT ["/usr/local/bin/law-oa-go"]
CMD ["serve"]