{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "legal_analyzer": {
          "type": "custom",
          "tokenizer": "ik_max_word",
          "filter": [
            "lowercase",
            "stop",
            "synonym",
            "legal_stemmer"
          ]
        },
        "legal_search_analyzer": {
          "type": "custom",
          "tokenizer": "ik_smart",
          "filter": [
            "lowercase",
            "stop",
            "synonym",
            "legal_stemmer"
          ]
        },
        "statute_number_analyzer": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter": [
            "lowercase",
            "trim"
          ]
        }
      },
      "filter": {
        "legal_stemmer": {
          "type": "stemmer",
          "language": "possessive_english"
        },
        "synonym": {
          "type": "synonym",
          "synonyms": [
            "民法,民法典,民事",
            "刑法,刑法典,刑事",
            "行政法,行政法规,行政",
            "公司法,企业法,公司",
            "合同法,契约,协议",
            "劳动法,劳工法,劳动",
            "知识产权,专利,商标,著作权",
            "诉讼,起诉,法庭,司法",
            "仲裁,调解,争议解决"
          ]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": {
        "type": "integer"
      },
      "statute_number": {
        "type": "text",
        "analyzer": "statute_number_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 100
          },
          "suggest": {
            "type": "completion",
            "analyzer": "keyword"
          }
        }
      },
      "title": {
        "type": "text",
        "analyzer": "legal_analyzer",
        "search_analyzer": "legal_search_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 200
          },
          "suggest": {
            "type": "completion",
            "analyzer": "legal_search_analyzer"
          }
        }
      },
      "content": {
        "type": "text",
        "analyzer": "legal_analyzer",
        "search_analyzer": "legal_search_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 1000
          }
        }
      },
      "law_name": {
        "type": "text",
        "analyzer": "legal_analyzer",
        "search_analyzer": "legal_search_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 200
          },
          "suggest": {
            "type": "completion",
            "analyzer": "legal_search_analyzer"
          }
        }
      },
      "chapter": {
        "type": "text",
        "analyzer": "legal_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 200
          }
        }
      },
      "section": {
        "type": "text",
        "analyzer": "legal_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 200
          }
        }
      },
      "part": {
        "type": "text",
        "analyzer": "legal_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 200
          }
        }
      },
      "category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "text",
            "analyzer": "legal_analyzer",
            "fields": {
              "keyword": {
                "type": "keyword"
              }
            }
          },
          "code": {
            "type": "keyword"
          }
        }
      },
      "effective_date": {
        "type": "date",
        "format": "yyyy-MM-dd"
      },
      "expiry_date": {
        "type": "date",
        "format": "yyyy-MM-dd"
      },
      "publishing_authority": {
        "type": "text",
        "analyzer": "legal_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 200
          }
        }
      },
      "status": {
        "type": "keyword"
      },
      "hierarchy_level": {
        "type": "integer"
      },
      "parent_statute_id": {
        "type": "integer"
      },
      "order_in_hierarchy": {
        "type": "integer"
      },
      "tags": {
        "type": "keyword"
      },
      "keywords": {
        "type": "text",
        "analyzer": "legal_analyzer",
        "search_analyzer": "legal_search_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "created_at": {
        "type": "date"
      },
      "updated_at": {
        "type": "date"
      },
      "content_length": {
        "type": "integer"
      },
      "view_count": {
        "type": "integer"
      },
      "favorite_count": {
        "type": "integer"
      },
      "search_weight": {
        "type": "float"
      }
    }
  }
}