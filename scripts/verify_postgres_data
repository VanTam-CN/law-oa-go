#!/bin/bash

echo "🔍 审批系统数据验证脚本"
echo "================================"

# 数据库连接信息
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="law_oa"

echo "📋 数据库配置:"
echo "  主机: $DB_HOST:$DB_PORT"
echo "  用户: $DB_USER"
echo "  数据库: $DB_NAME"
echo ""

# 检查 PostgreSQL 是否运行
echo "🔍 检查 PostgreSQL 服务状态..."
if ! pg_isready -h $DB_HOST -p $DB_PORT -U $DB_USER; then
    echo "❌ PostgreSQL 服务未运行，请先启动 PostgreSQL"
    echo "💡 提示: brew services start postgresql"
    exit 1
fi

echo "✅ PostgreSQL 服务运行正常"
echo ""

# 检查数据库是否存在
echo "🔍 检查数据库是否存在..."
if PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -lqt | cut -d \| -f 1 | grep -qw $DB_NAME; then
    echo "✅ 数据库 '$DB_NAME' 存在"
else
    echo "❌ 数据库 '$DB_NAME' 不存在"
    echo "💡 提示: 请先运行数据库迁移"
    exit 1
fi
echo ""

# 检查审批表是否存在
echo "🔍 检查审批相关表结构..."
TABLES=("approval_requests" "approval_records" "approval_workflows" "approval_templates")

for table in "${TABLES[@]}"; do
    if PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -c "\dt $table" | grep -q "$table"; then
        echo "✅ 表 '$table' 存在"

        # 检查表数据量
        count=$(PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -t -c "SELECT COUNT(*) FROM $table" | tr -d ' ')
        echo "   📊 数据量: $count 条记录"
    else
        echo "❌ 表 '$table' 不存在"
    fi
done
echo ""

# 检查审批申请数据
echo "🔍 检查审批申请数据..."
if PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -c "\dt approval_requests" | grep -q "approval_requests"; then
    echo "📋 审批申请数据统计:"

    # 按状态统计
    echo "   📈 按状态统计:"
    PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -c "
        SELECT
            status as 状态,
            COUNT(*) as 数量,
            COUNT(*) * 100.0 / (SELECT COUNT(*) FROM approval_requests) as 百分比
        FROM approval_requests
        GROUP BY status
        ORDER BY COUNT(*) DESC;
    "

    echo ""
    echo "   📈 按申请人统计:"
    PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -c "
        SELECT
            applicant_name as 申请人,
            COUNT(*) as 申请数量
        FROM approval_requests
        GROUP BY applicant_name
        ORDER BY COUNT(*) DESC;
    "

    echo ""
    echo "   📈 按类型统计:"
    PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -c "
        SELECT
            type as 类型,
            category as 分类,
            COUNT(*) as 数量
        FROM approval_requests
        GROUP BY type, category
        ORDER BY COUNT(*) DESC;
    "

    echo ""
    echo "   📋 最近的申请:"
    PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -c "
        SELECT
            request_number as 申请编号,
            title as 标题,
            applicant_name as 申请人,
            status as 状态,
            created_at as 创建时间
        FROM approval_requests
        ORDER BY created_at DESC
        LIMIT 5;
    "
else
    echo "❌ 审批申请表不存在"
fi
echo ""

# 检查用户数据
echo "🔍 检查用户数据..."
if PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -c "\dt users" | grep -q "users"; then
    echo "👥 用户数据统计:"
    PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -c "
        SELECT
            COUNT(*) as 用户总数,
            COUNT(DISTINCT id) as 唯一用户数
        FROM users;
    "

    echo ""
    echo "   👥 用户列表:"
    PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -c "
        SELECT
            id as ID,
            name as 姓名,
            email as 邮箱,
            role as 角色
        FROM users
        ORDER BY id
        LIMIT 10;
    "
else
    echo "⚠️ 用户表不存在或无法访问"
fi
echo ""

# 生成数据修复建议
echo "💡 数据修复建议:"
echo "================================"

if PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -t -c "SELECT COUNT(*) FROM approval_requests" | tr -d ' ' | grep -q "^0$"; then
    echo "📝 审批申请表为空，建议运行以下命令创建测试数据:"
    echo "   cd $(dirname $0)"
    echo "   go run create_approval_test_data.go"
    echo ""
fi

if PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -c "\dt users" | grep -q "users"; then
    user_count=$(PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -t -c "SELECT COUNT(*) FROM users" | tr -d ' ')
    if [ "$user_count" -eq 0 ]; then
        echo "👥 用户表为空，建议创建测试用户"
    fi
fi

echo ""
echo "🎯 排查步骤:"
echo "1. 确保 PostgreSQL 服务运行: brew services start postgresql"
echo "2. 确保数据库迁移完成: 检查 migration 文件"
echo "3. 运行测试数据脚本: go run scripts/create_approval_test_data.go"
echo "4. 启动后端服务测试 API: ./law-oa-server"
echo "5. 启动前端服务测试界面: cd frontend && npm run dev"
echo ""

echo "✅ 数据验证完成！"