# Law OA Go 环境配置模板
# 复制此文件为 .env.local 并根据需要修改配置

# ======================
# 应用基础配置
# ======================
ENVIRONMENT=development
DEBUG=true
VERSION=2.1.0
PORT=8080
HOST=0.0.0.0

# ======================
# 数据库配置
# ======================
# PostgreSQL 是当前生产 bootstrap 的唯一受支持方言；本地开发也建议使用同一方言。
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
DB_USERNAME=law_oa_user
DB_PASSWORD=local-dev-db-password-change-me
DB_DATABASE=law_oa
DB_LOC=Asia/Shanghai
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m

# ======================
# Redis缓存配置
# ======================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s
REDIS_IDLE_TIMEOUT=5m

# ======================
# Elasticsearch配置
# ======================
# 只填写主机名；程序会按 ES_PORT 拼接 http:// 和端口
ES_HOST=elasticsearch
ES_USERNAME=
ES_PASSWORD=
ES_MAX_RETRIES=3
ES_RETRY_BACKOFF=100ms
ES_MAX_BULK_SIZE=50
ES_WORKERS=4

# ======================
# JWT认证配置
# ======================
# 注意：生产环境请使用随机生成的强密钥，至少32个字符
JWT_SECRET=local-dev-jwt-secret-change-before-production-2026
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_HOURS=168

# 应用签名密钥（仅本地开发占位；生产必须替换）
APP_SECRET=local-dev-app-secret-change-before-production-2026

# 主体身份标识加密密钥（生产必填；必须是32字节的base64、hex或原始字符串）
# 用于加密案件主体变更中身份证号、统一社会信用代码等敏感字段，不能与JWT_SECRET复用
# 仅用于本地开发/演练；生产环境必须替换为独立的随机 32 字节密钥
SUBJECT_DATA_KEY=01234567890123456789012345678901

# ======================
# 日志配置
# ======================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_ENABLE_CALLER=true
LOG_ENABLE_STACKTRACE=false
LOG_SAMPLING_PERIOD=1s
LOG_INITIAL_CAP=1000
LOG_MAX_CAP=10000

# ======================
# 安全配置
# ======================
# CORS配置 (生产环境请修改为实际域名)
CORS_ALLOWED_ORIGINS=http://localhost:3003,http://localhost:8080,https://lawoa.com,https://www.lawoa.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Authorization,Idempotency-Key,X-Request-ID
CORS_EXPOSE_HEADERS=Content-Length,Content-Type
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=43200

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ======================
# 文件上传配置
# ======================
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
UPLOAD_STORAGE_PATH=/app/uploads
UPLOAD_MAX_FILES=10

# ======================
# 缓存配置
# ======================
CACHE_DEFAULT_TTL=5m
CACHE_CLEANUP_INTERVAL=10m
CACHE_MAX_SIZE=10000

# ======================
# 监控配置
# ======================
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics
PROMETHEUS_PORT=9090

OPENTELEMETRY_ENABLED=true
OTEL_SERVICE_NAME=law-oa-go
OTEL_SERVICE_VERSION=2.1.0
OTEL_ENVIRONMENT=development
OTEL_SAMPLING_RATE=1.0
OTEL_EXPORTER=otlp
OTEL_ENDPOINT=http://jaeger:4318
OTEL_HEADERS=authorization=Bearer ${OTEL_TOKEN}

# ======================
# 开发环境特定配置
# ======================
# 热重载配置 (仅开发环境)
AIR_ENABLED=true
AIR_CONFIG_FILE=.air.toml

# 前端开发服务器配置 (仅开发环境)
FRONTEND_DEV_SERVER=true
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3003

# ======================
# 生产环境特定配置
# ======================
# SSL/TLS配置 (生产环境)
SSL_ENABLED=false
SSL_CERT_FILE=
SSL_KEY_FILE=

# 数据库连接池配置 (生产环境优化)
DB_LEAK_DETECTION=true
DB_STATS=true
DB_SET_CONN_MAX_LIFETIME=true

# 性能监控 (生产环境)
PPROF_ENABLED=false
PPROF_PORT=6060

# ======================
# 第三方服务配置
# ======================
# 邮件服务配置
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@lawoa.com

# 对象存储配置 (文件上传)
OSS_ENABLED=false
OSS_PROVIDER=aws
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_BUCKET=lawoa-files
OSS_REGION=us-east-1

# 短信服务配置
SMS_ENABLED=false
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=LawOA

# ======================
# 环境变量说明
# ======================
# ENVIRONMENT: 运行环境 (development|staging|production)
# DEBUG: 是否启用调试模式 (true|false)
# LOG_LEVEL: 日志级别 (debug|info|warn|error)
# JWT_SECRET: JWT密钥，生产环境必须使用强密钥
# APP_SECRET: 应用级签名/加密密钥，生产环境必须使用独立强密钥
# SUBJECT_DATA_KEY: 主体身份标识加密密钥，生产环境必须配置且不能与其他密钥复用
# CORS_ALLOWED_ORIGINS: 允许的跨域源，生产环境必须指定实际域名

# ======================
# 开发使用说明
# ======================
# 1. 复制此文件为 .env.local
# 2. 根据开发环境需要修改配置
# 3. 运行 ./start.sh dev 启动开发环境
# 4. 访问 http://localhost:3003 查看前端
# 5. 访问 http://localhost:8080 查看后端API
