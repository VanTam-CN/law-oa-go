{
  "dashboard": {
    "id": null,
    "title": "律师事务所OA系统 - 业务指标",
    "tags": ["law-oa", "business", "metrics"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "案件统计",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "law_oa_cases_total",
            "legendFormat": "总案件数",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 100},
                {"color": "red", "value": 500}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "活跃案件数",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "law_oa_active_cases_total",
            "legendFormat": "活跃案件",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 200}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "客户总数",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "law_oa_clients_total",
            "legendFormat": "客户总数",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 200}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "律师总数",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "law_oa_lawyers_total",
            "legendFormat": "律师总数",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 50}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "案件创建趋势",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "increase(law_oa_cases_created_total[1h])",
            "legendFormat": "每小时创建案件数",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "案件数/小时", "min": 0}
        ]
      },
      {
        "id": 6,
        "title": "案件状态分布",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "law_oa_cases_by_status",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "案件类型分布",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "law_oa_cases_by_type",
            "legendFormat": "{{case_type}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "优先级分布",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "law_oa_cases_by_priority",
            "legendFormat": "{{priority}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 9,
        "title": "用户活动统计",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(law_oa_user_actions_total[5m])",
            "legendFormat": "{{action}} {{user_role}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "操作/秒", "min": 0}
        ]
      },
      {
        "id": 10,
        "title": "冲突检测统计",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "rate(law_oa_conflict_checks_total[5m])",
            "legendFormat": "冲突检查频率",
            "refId": "A"
          },
          {
            "expr": "rate(law_oa_conflicts_detected_total[5m])",
            "legendFormat": "检测到冲突频率",
            "refId": "B"
          }
        ],
        "yAxes": [
          {"label": "检查/秒", "min": 0}
        ]
      },
      {
        "id": 11,
        "title": "文档上传统计",
        "type": "graph",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "increase(law_oa_documents_uploaded_total[1h])",
            "legendFormat": "每小时上传文档数",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "文档数/小时", "min": 0}
        ]
      },
      {
        "id": 12,
        "title": "存储使用情况",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 32},
        "targets": [
          {
            "expr": "law_oa_storage_used_bytes",
            "legendFormat": "已用存储",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "bytes",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 10737418240},
                {"color": "red", "value": 53687091200}
              ]
            }
          }
        }
      },
      {
        "id": 13,
        "title": "API使用统计",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "topk(10, sum by (path) (rate(http_requests_total[5m])))",
            "legendFormat": "{{path}}",
            "refId": "A",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        }
      }
    ],
    "time": {"from": "now-24h", "to": "now"},
    "refresh": "1m"
  }
}