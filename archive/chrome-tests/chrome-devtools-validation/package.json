{
  "name": "chrome-devtools-validation",
  "version": "1.0.0",
  "description": "Comprehensive test framework for Law OA System using Chrome DevTools MCP",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:chrome": "npm run build && node dist/test-runner.js",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "report:generate": "node dist/report-generator.js"
  },
  "keywords": [
    "testing",
    "chrome-devtools",
    "automation",
    "e2e",
    "law-oa"
  ],
  "author": "Law OA Team",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "winston": "^3.10.0",
    "yaml": "^2.3.0",
    "fs-extra": "^11.1.0",
    "uuid": "^9.0.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.6.0",
    "jest-environment-node": "^29.6.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}