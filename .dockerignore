# 基于最佳实践的Docker构建忽略文件
# 优化构建上下文，提高构建速度和安全性

# 版本控制
.git
.gitignore
.gitattributes
.github
.worktrees/
.gemini-clipboard/
.playwright-mcp/
pet-runs/
graphify-out/

# 文档和配置文件
README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE
Makefile
Dockerfile*
docker-compose*
.dockerignore

# 开发工具和IDE配置
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 测试文件和覆盖率
*_test.go
coverage.out
coverage.html
*.cover
test-results/
tests/

# 依赖和缓存
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 构建产物和临时文件
dist/
build/
out/
*.exe
*.dll
*.so
*.dylib
*.log
*.tmp
*.bak

# 环境配置文件（敏感信息）
.env
.env.local
.env.*.local
config/local.yaml
config/production.yaml

# 数据库文件
*.db
*.sqlite
*.sqlite3
data/

# 日志文件
logs/
*.log

# 上传文件目录
uploads/
files/
storage/

# 缓存目录
.cache/
.cache-*/

# 运行时文件
*.pid
*.seed
*.pid.lock

# 临时脚本和工具
scripts/
tools/
dev/

# 本地配置
config/local/
config/dev/

# 监控和调试
debug/
profiling/
*.prof
*.pprof

# 文档生成
docs/_build/
docs/
!docs/
docs/*
!docs/docs.go
reports/
frontend/
docs/site/

# 备份文件
*.bak
*.backup
*.old

# 压缩文件
*.tar.gz
*.zip
*.rar

# Local compiled binaries and build outputs
bin/
law-oa-go
law-oa-server
law-oa-server-*
main
migrate
server
law-oa

# 系统文件
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# 前端相关（如果分离构建）
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/

# 本地开发和测试
local/
tmp/
temp/
*.tmp

# 数据库迁移临时文件
*.sql.bak
migration-backups/

# 密钥和证书
*.pem
*.key
*.crt
*.p12
secrets/

# 性能分析
*.prof
*.pprof
*.trace

# 其他工具配置
.eslintrc*
.prettierrc*
.editorconfig
.stylelintrc*
