# OnlyOffice Document Server 环境变量配置示例
# 复制此文件为 .env.document 并修改相应的值

# OnlyOffice 服务配置
ONLYOFFICE_PORT=9090
ONLYOFFICE_JWT_SECRET=your-onlyoffice-jwt-secret-change-me-in-production

# 数据库配置
ONLYOFFICE_DB_PORT=55432

# Redis 配置
ONLYOFFICE_REDIS_PORT=6380

# RabbitMQ 配置
ONLYOFFICE_RABBITMQ_PORT=15772
ONLYOFFICE_RABBITMQ_MGMT_PORT=16772

# 数据目录
DATA_DIR=./data
